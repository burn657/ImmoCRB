<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set titrePage = titreComplet or ((title + " | " + site.nom) if title else (site.nom + " | " + site.courtier + ", courtier immobilier résidentiel")) -%}
{%- set descPage = description or (site.nom + " : " + site.courtier + ", " + (site.titre | lower) + " chez " + site.agence + ". Achat et vente de maisons et de condos à " + site.region + ". Estimation gratuite.") -%}
{%- set imagePage = site.url + (image or "/images/apercu-partage.jpg") -%}
<title>{{ titrePage }}</title>
<meta name="description" content="{{ descPage }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" type="image/png" href="/images/favicon.png">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
<meta name="theme-color" content="#005a9c">
<meta property="og:type" content="website">
<meta property="og:locale" content="fr_CA">
<meta property="og:site_name" content="{{ site.nom }}">
<meta property="og:title" content="{{ titrePage }}">
<meta property="og:description" content="{{ descPage }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ imagePage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ titrePage }}">
<meta name="twitter:description" content="{{ descPage }}">
<meta name="twitter:image" content="{{ imagePage }}">
{% if page.url == "/" %}<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  "name": site.nom + " | " + site.courtier,
  "url": site.url + "/",
  "image": site.url + site.photo,
  "logo": site.url + "/images/apple-touch-icon.png",
  "telephone": "+1-" + site.telephone,
  "email": site.courriel,
  "address": { "@type": "PostalAddress", "streetAddress": "280A, boul. de la Seigneurie Ouest", "addressLocality": "Blainville", "addressRegion": "QC", "postalCode": "J7C 5A1", "addressCountry": "CA" },
  "areaServed": ["Montréal", "Laval", "Rive-Nord", "Laurentides", "Lanaudière"],
  "parentOrganization": { "@type": "Organization", "name": site.agence },
  "sameAs": [site.facebook, site.instagram]
} | dump | safe }}</script>{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<a class="skip" href="#contenu">Aller au contenu</a>
<header class="entete">
  <div class="conteneur entete__in">
    <div class="marque">
      <a href="/" class="logo" aria-label="Immo CRB, accueil"><img src="/images/logo-goutte.gif" alt="" width="46" height="52" class="logo__img"><span class="logo__txt">Immo<span>CRB</span></span></a>
      <div class="marque__via">
        <img src="/images/via-capitale-courtier.png" alt="Claude-René Brûlé, courtier immobilier résidentiel, Via Capitale" width="60" height="60">
        <img src="/images/via-capitale-partenaires.png" alt="Via Capitale Partenaires, agence immobilière" width="60" height="60">
      </div>
    </div>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu">Menu</button>
    <nav id="menu" class="nav" aria-label="Navigation principale">
      <a href="/proprietes/">Propriétés</a>
      <a href="/acheter/">Acheter</a>
      <a href="/vendre/">Vendre</a>
      <a href="/outils/">Outils</a>
      <a href="/a-propos/">À propos</a>
      <a href="/contact/">Contact</a>
      <a href="/estimation/" class="btn btn--petit">Estimation gratuite</a>
    </nav>
  </div>
</header>

<main id="contenu">
{{ content | safe }}
</main>

<footer class="pied">
  <div class="conteneur pied__in">
    <div>
      <p class="pied__nom">{{ site.nom }}</p>
      <p>{{ site.courtier }}, {{ site.titre | lower }} · {{ site.agence }}</p>
      <p>Permis OACIQ {{ site.permis }}</p>
    </div>
    <div>
      <p><a href="tel:+1{{ site.telephone | replace('-', '') }}">{{ site.telephone }}</a></p>
      <p><a href="mailto:{{ site.courriel }}">{{ site.courriel }}</a></p>
      <p>{{ site.adresse }}</p>
    </div>
    <div class="pied__social">
      {% if site.facebook %}<a href="{{ site.facebook }}">Facebook</a>{% endif %}
      {% if site.instagram %}<a href="{{ site.instagram }}">Instagram</a>{% endif %}
      {% if site.youtube %}<a href="{{ site.youtube }}">YouTube</a>{% endif %}
    </div>
    <p class="pied__legal"><a href="/confidentialite/">Politique de confidentialité</a></p>
  </div>
</footer>
<script>
  const b = document.querySelector('.menu-btn'), n = document.getElementById('menu');
  b.addEventListener('click', () => { const o = n.classList.toggle('ouvert'); b.setAttribute('aria-expanded', o); });
</script>
</body>
</html>
